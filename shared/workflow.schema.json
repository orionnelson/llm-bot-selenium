{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workflow-studio:v1",
  "title": "Workflow Studio v1 manifest",
  "description": "Offline intent IR. Apply runtime semantic validation in addition to this structural schema: URLs, privacy, bindings, IDs, edges, DAG and structured fork/join regions. Provenance is a claim, not execution evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "synthetic", "page", "nodes", "edges"],
  "properties": {
    "version": { "const": "workflow-studio/v1" },
    "title": { "type": "string", "maxLength": 160 },
    "synthetic": { "type": "boolean" },
    "page": {
      "type": "object", "additionalProperties": false, "required": ["urlTemplate", "parameters"],
      "properties": {
        "urlTemplate": { "type": "string", "maxLength": 8192, "pattern": "^https?://" },
        "parameters": { "type": "object", "maxProperties": 64, "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "type": "string", "maxLength": 500 } }
      }
    },
    "nodes": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/node" } },
    "edges": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "source", "target"],
        "properties": { "id": { "$ref": "#/$defs/id" }, "source": { "$ref": "#/$defs/id" }, "target": { "$ref": "#/$defs/id" } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$", "not": { "enum": ["__proto__", "constructor", "prototype"] } },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "title", "position", "provenance", "bindings"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["page", "action", "segment", "fork", "join"] },
        "title": { "type": "string", "maxLength": 160 },
        "position": {
          "type": "object", "additionalProperties": false, "required": ["x", "y"],
          "properties": { "x": { "type": "number", "minimum": -100000, "maximum": 100000 }, "y": { "type": "number", "minimum": -100000, "maximum": 100000 } }
        },
        "provenance": { "enum": ["observed", "detected", "model-proposed", "approved", "executed"] },
        "bindings": { "type": "object", "maxProperties": 64, "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/id" } },
        "pairId": { "$ref": "#/$defs/id" },
        "prompt": { "type": "string", "maxLength": 2000 },
        "action": {
          "type": "object", "additionalProperties": false, "required": ["verb", "target"],
          "properties": { "verb": { "enum": ["click", "navigate", "inspect", "type"] }, "target": { "type": "string", "maxLength": 500 } }
        },
        "review": { "enum": ["pending", "approved"] },
        "origin": { "enum": ["offline-template", "user-authored", "model"] },
        "timestamp": { "type": "number", "minimum": 0, "maximum": 86400 }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "enum": ["fork", "join"] } } }, "then": { "required": ["pairId"] }, "else": { "not": { "required": ["pairId"] } } },
        { "if": { "properties": { "provenance": { "const": "model-proposed" } } }, "then": { "required": ["prompt", "action", "review", "origin"], "properties": { "review": { "const": "pending" } } } }
      ]
    }
  }
}
